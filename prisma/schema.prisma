datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id                 String   @id
  title              String
  price              Int
  originalPrice      Int
  discount           Int
  rating             Float
  reviewsCount       Int
  image              String
  category           String
  brand              String
  description        String
  inStock            Boolean
  featured           Boolean  @default(false)
  trending           Boolean  @default(false)
  emiAvailable       Boolean  @default(false)
  specs              Json
  variants           Json?
  addons             Json?
  
  // Trader Fields
  isApproved         Boolean  @default(true)
  isTraderProduct    Boolean  @default(false)
  traderEmail        String?
  status             String?  @default("Approved")
  feedback           String?
  commissionPercent  Int?     @default(10)
}

model Order {
  id             String   @id
  customerName   String
  customerPhone  String
  customerEmail  String
  address        String
  city           String
  items          Json
  totalPrice     Int
  paymentMethod  String
  status         String   @default("Pending")
  createdAt      DateTime @default(now())
}

model Course {
  id           String   @id @default(cuid())
  title        String
  description  String
  type         String   // physical or online
  price        Int
  duration     String
  location     String?
  schedule     String?
  image        String?  // cover photo URL
  videos       Json?    // [{ title: string, duration: string, url: string }]
  notes        Json?    // [{ title: string, downloadUrl: string }]
  createdAt    DateTime @default(now())
}

model CourseEnrollment {
  id             String   @id @default(cuid())
  courseId       String
  courseTitle    String
  courseType     String
  customerName   String
  customerEmail  String
  customerPhone  String
  amountPaid     Int
  paymentMethod  String
  status         String   @default("Completed")
  createdAt      DateTime @default(now())
}

model RepairRequest {
  id             String   @id @default(cuid())
  customerName   String
  customerEmail  String
  customerPhone  String
  brand          String
  modelName      String
  problemType    String
  description    String
  status         String   @default("Pending") // Pending, Approved, Received, Repairing, Fixed, Returned, Rejected, Cancelled
  adminFeedback  String?
  estimateCost   Int?
  paymentMethod  String?
  paymentStatus  String   @default("Unpaid")
  cancelReason   String?  // reason for cancellation
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Page {
  id          String   @id @default(cuid())
  title       String   // Internal name
  slug        String   @unique
  status      String   @default("draft") // "draft" or "published"
  
  // Builder JSON Data
  content     Json     @default("{\"children\":[]}")
  
  // SEO Data
  seoTitle       String?
  seoDescription String?
  keywords       String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  indexing       Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("customer") // customer, trader, admin
  isTrader  Boolean  @default(false)
  avatar    String?
  address   String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalSettings {
  id                   String   @id @default("global")
  
  // Active Site Theme
  theme                String   @default("professional-1")
  
  // CMS Layout & Sections
  sectionsByRoute      Json?
  sectionCustomizations Json?
  customSectionsData   Json?
  globalSections       Json?
  
  // Header & Footer
  headerSettings       Json?
  footerSettings       Json?
  
  // Categories
  categories           Json?
  
  // Saved Assets & Overrides
  savedAssets          Json?
  imageOverrides       Json?
  styleOverrides       Json?
  
  // Global SEO defaults
  siteTitle            String?
  siteDescription      String?
  defaultOgImage       String?
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

