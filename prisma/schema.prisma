datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id            String   @id
  title         String
  price         Int
  originalPrice Int
  discount      Int
  rating        Float
  reviewsCount  Int
  image         String
  category      String
  brand         String
  description   String
  inStock       Boolean
  featured      Boolean  @default(false)
  trending      Boolean  @default(false)
  emiAvailable  Boolean  @default(false)
  specs         Json
  variants      Json?
  addons        Json?
}

model Order {
  id             String   @id
  customerName   String
  customerPhone  String
  customerEmail  String
  address        String
  city           String
  items          Json
  totalPrice     Int
  paymentMethod  String
  status         String   @default("Pending")
  createdAt      DateTime @default(now())
}

model Page {
  id          String   @id @default(cuid())
  title       String   // Internal name
  slug        String   @unique
  status      String   @default("draft") // "draft" or "published"
  
  // Builder JSON Data
  content     Json     @default("{\"children\":[]}")
  
  // SEO Data
  seoTitle       String?
  seoDescription String?
  keywords       String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  indexing       Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GlobalSettings {
  id          String   @id @default("global")
  
  // Global SEO defaults
  siteTitle       String?
  siteDescription String?
  defaultOgImage  String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
